# =========================================================
# Dating Platform - Variables de entorno de PRODUCCIÓN (ejemplo)
#
# Copia este archivo como .env en el servidor de producción y rellena
# TODOS los valores marcados con [CAMBIAR]. Nunca reutilices las
# contraseñas/secretos de .env.example (desarrollo): son públicas, de
# hecho, están en este repositorio.
# =========================================================

APP_ENV=production

# --- Dominio (Caddyfile.prod obtiene HTTPS automático para este dominio) ---
DOMAIN=[CAMBIAR: tu-dominio.com]

# --- PostgreSQL ---
POSTGRES_USER=[CAMBIAR]
POSTGRES_PASSWORD=[CAMBIAR: contraseña larga y aleatoria]
POSTGRES_DB=dating_app
# En producción, postgres ya no publica su puerto al host (ver
# docker-compose.prod.yml): estas variables solo las usa la red interna
# de Docker, POSTGRES_HOST debe seguir siendo "postgres".
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=[CAMBIAR: recomendado en producción]
REDIS_DB=0

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
LOG_LEVEL=info

# --- Autenticación / sesiones ---
SESSION_TTL_HOURS=720
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
SESSION_COOKIE_NAME=session_id

# --- Email: SMTP real (sustituye al driver "noop" de desarrollo) ---
EMAIL_DRIVER=smtp
EMAIL_FROM=[CAMBIAR: no-reply@tu-dominio.com]
CONTACT_INBOX_EMAIL=[CAMBIAR: contacto@tu-dominio.com]
SMTP_HOST=[CAMBIAR: smtp.tu-proveedor.com]
SMTP_PORT=587
SMTP_USERNAME=[CAMBIAR]
SMTP_PASSWORD=[CAMBIAR]

# --- Storage: S3-compatible (sustituye al driver "local" de desarrollo) ---
# El bucket debe existir ya: el backend comprueba que es accesible al
# arrancar y falla pronto si no.
STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT=[CAMBIAR: s3.amazonaws.com / nyc3.digitaloceanspaces.com / tu-minio:9000 ...]
STORAGE_S3_REGION=[CAMBIAR: p.ej. eu-west-1]
STORAGE_S3_BUCKET=[CAMBIAR]
STORAGE_S3_ACCESS_KEY=[CAMBIAR]
STORAGE_S3_SECRET_KEY=[CAMBIAR]
STORAGE_S3_USE_SSL=true
# true para MinIO/algunos proveedores no-AWS; false para AWS S3 real.
STORAGE_S3_FORCE_PATH_STYLE=false

# --- Seguridad / rate limiting ---
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
MAX_REQUEST_BODY_MB=10

# --- Frontend ---
# Debe ser la URL pública real (https, tu dominio): el navegador la usa
# para llamar a la API a través de Caddy.
NEXT_PUBLIC_API_URL=https://[CAMBIAR: tu-dominio.com]/api/v1
# El servidor de Next.js sigue llamando al backend dentro de la red de
# Docker: esto NO cambia respecto a desarrollo.
INTERNAL_API_URL=http://backend:8080/api/v1
