:80 {
	# API del backend (Go) versionada bajo /api/v1
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Healthcheck de infraestructura expuesto directamente (sin prefijo /api)
	handle /healthz {
		reverse_proxy backend:8080
	}

	# Todo lo demás va al frontend (Next.js)
	handle {
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format console
	}
}
