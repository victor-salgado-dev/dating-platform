# =========================================================
# Dating Platform - Variables de entorno (ejemplo)
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el archivo .env real a Git.
# =========================================================

# --- Entorno general ---
APP_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=dating_app
POSTGRES_PASSWORD=changeme_dev_password
POSTGRES_DB=dating_app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# sslmode=disable solo es aceptable en desarrollo local
POSTGRES_SSLMODE=disable

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Backend (Go) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
# Nivel de log: debug | info | warn | error
LOG_LEVEL=debug

# --- Autenticación / sesiones ---
# Duración de la sesión (cookie httpOnly), en horas. 720h = 30 días.
SESSION_TTL_HOURS=720
# Duración de los tokens de verificación de email y de reset de contraseña.
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
SESSION_COOKIE_NAME=session_id

# --- Email (abstracción, driver "noop" registra en logs en vez de enviar) ---
EMAIL_DRIVER=noop
EMAIL_FROM=no-reply@example.com
# Bandeja a la que llegan los mensajes del formulario de contacto (Fase 13).
CONTACT_INBOX_EMAIL=contact@example.com

# --- Seguridad / rate limiting (Redis) ---
# Límite global, generoso, por IP, aplicado a toda la API.
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=300
# Límite estricto por IP solo para endpoints sensibles de auth
# (register, login, password/forgot, password/reset, email/verify, email/resend).
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
# Tamaño máximo de cualquier cuerpo de petición (backstop de memoria/DoS).
MAX_REQUEST_BODY_MB=10

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
# URL pública que usará el NAVEGADOR (llamadas desde componentes cliente),
# a través de Caddy en el mismo origen.
NEXT_PUBLIC_API_URL=http://localhost/api/v1
# URL que usa el SERVIDOR de Next.js (Server Components / SSR) para llamar
# al backend directamente dentro de la red de Docker. 'localhost' dentro
# del contenedor del frontend no resuelve al backend, por eso son distintas.
INTERNAL_API_URL=http://backend:8080/api/v1

# --- Caddy (reverse proxy) ---
CADDY_HTTP_PORT=80

# --- Storage (abstracción, ver backend/internal/storage en fases futuras) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/uploads

# --- Tests de integración ---
# NO hace falta configuración aquí: el Makefile deriva la cadena de conexión
# de los tests a partir de los POSTGRES_* de arriba e inyecta
# TEST_DATABASE_URL con `docker compose run -e ...`. Además los tests usan
# una base de datos SEPARADA (`<POSTGRES_DB>_test`), nunca la de desarrollo,
# para no sembrar datos de prueba en la app. Ver targets `test-db-init` y
# `test-integration` en el Makefile.
