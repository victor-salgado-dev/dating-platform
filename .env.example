# =========================================================
# Dating Platform - Variables de entorno (ejemplo)
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el archivo .env real a Git.
# =========================================================

# --- Entorno general ---
APP_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=dating_app
POSTGRES_PASSWORD=changeme_dev_password
POSTGRES_DB=dating_app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# sslmode=disable solo es aceptable en desarrollo local
POSTGRES_SSLMODE=disable

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Backend (Go) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
# Nivel de log: debug | info | warn | error
LOG_LEVEL=debug

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
# URL pública que usará el navegador para llamar a la API (a través de Caddy)
NEXT_PUBLIC_API_URL=http://localhost/api/v1

# --- Caddy (reverse proxy) ---
CADDY_HTTP_PORT=80

# --- Storage (abstracción, ver backend/internal/storage en fases futuras) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/uploads

# --- Email (abstracción, se implementará en fases futuras) ---
EMAIL_DRIVER=noop
